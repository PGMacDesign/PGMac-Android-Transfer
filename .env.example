# Copy to .env and adjust. Every value is optional.

# HTTP port for the local UI (bound to 127.0.0.1 only)
PORT=4848

# Preferred device IP. If set and found on the network, Start Session connects to it automatically.
# A value saved in the app's settings takes precedence.
DEFAULT_DEVICE_IP=

# Maximum number of transfers running at once (1-6)
MAX_CONCURRENT_TRANSFERS=3

# Explicit path to the adb binary. If unset, PATH, $ANDROID_HOME and the default SDK location are searched.
# A path saved in the app's settings takes precedence.
ADB_PATH=

# Open the default browser on start
OPEN_BROWSER=true

# Optional token the page and API share. Leave empty to generate a new one at each start (recommended).
# If set, use letters, digits, '-', '_' and '.' only.
API_TOKEN=

# Optional folder for state.json (saved settings and the last device).
# Defaults to ~/.config/pgmac-transfer.
STATE_DIR=
