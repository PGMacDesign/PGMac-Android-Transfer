{
  "name": "pgmac-android-transfer",
  "version": "0.1.0",
  "description": "Move files between a Mac and an Android device over WiFi (ADB Wireless Debugging) from a two-pane file manager in your browser.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "vite build && node src/server/index.ts",
    "app": "vite build && electron electron/main.ts",
    "dev": "node scripts/dev.ts",
    "dev:server": "node --watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:emulator": "PGMAC_EMULATOR_TEST=1 vitest run test/integration",
    "make": "vite build && electron-builder --mac --config electron-builder.config.ts",
    "make:signed": "PGMAC_SIGN=1 npm run make"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.3.3",
    "fastify": "^5.12.5",
    "open": "^11.0.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "material-symbols": "^0.47.6",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "main": "electron/main.ts"
}
